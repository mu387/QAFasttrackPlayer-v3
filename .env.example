# Runner self-update (Electron Squirrel)
#
# Squirrel feed = a directory on public object storage containing:
#   RELEASES                     (plain ASCII, no BOM)
#   <app>-<version>-full.nupkg
#   <app>-<version>-Setup.exe    (manual installs)
#
# UPDATE_MODE=auto   -> check on launch + every 4h, download in background, offer restart
# UPDATE_MODE=manual -> never download; show a Download button (locked-down client machines)
#
# Signing is not required for updates to work: Squirrel verifies each package against
# the SHA-1 in RELEASES. A code-signing certificate only removes SmartScreen warnings.

UPDATE_MODE=auto
UPDATE_FEED_URL=https://qafasttrack.nyc3.digitaloceanspaces.com/<env>/runner-updates/stable/windows/
UPDATE_DOWNLOAD_URL=https://<api-host>/api/runner-updates/download-latest
